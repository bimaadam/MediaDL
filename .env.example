# Copy to .env for local compose. These values are local dummies, not production secrets.
POSTGRES_USER=media
POSTGRES_PASSWORD=media-dev-password
POSTGRES_DB=media
# S3 API endpoint without a bucket path. Compose requires this.
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# EU jurisdiction: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2 region is auto.
S3_ENDPOINT=
S3_ACCESS_KEY=media-dev-access
S3_SECRET_KEY=media-dev-secret-key
S3_BUCKET=media
S3_REGION=us-east-1

# Optional. Leave the token empty to keep the Telegram adapter off.
# A non-empty token turns it on. Bot id is the number before the colon in the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
MEDIA_ENGINE__TELEGRAM__ENABLED=false

# Honored only when MEDIA_ENGINE_ENVIRONMENT=development.
MIGRATE_ON_START=true
MEDIA_ENGINE_ENVIRONMENT=development
